<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setting_homepage"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/homepageInput"
            style="@style/EditField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setting_history_limit"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/historyLimitInput"
            style="@style/EditField"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setting_cursor_speed"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/cursorSpeed"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="16" />

        <CheckBox
            android:id="@+id/deleteAfterInstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="10dp"
            android:text="@string/setting_delete_after_install"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/confirmBeforeDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:text="@string/setting_confirm_before_download"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/saveButton"
                style="@style/ActionButton"
                android:text="@string/save" />

            <TextView
                android:id="@+id/clearHistoryButton"
                style="@style/ActionButton"
                android:layout_marginStart="10dp"
                android:text="@string/setting_clear_history" />

            <TextView
                android:id="@+id/clearFilesButton"
                style="@style/ActionButton"
                android:layout_marginStart="10dp"
                android:text="@string/setting_clear_files" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/backButton"
            style="@style/ActionButton"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="◀" />

        <TextView
            android:id="@+id/forwardButton"
            style="@style/ActionButton"
            android:layout_marginStart="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="▶" />

        <TextView
            android:id="@+id/reloadButton"
            style="@style/ActionButton"
            android:layout_marginStart="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="⟳" />

        <EditText
            android:id="@+id/urlBar"
            style="@style/EditField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/cursorButton"
            style="@style/ActionButton"
            android:layout_marginStart="8dp"
            android:text="@string/cursor_mode" />

        <TextView
            android:id="@+id/downloadPageButton"
            style="@style/ActionButton"
            android:layout_marginStart="6dp"
            android:text="@string/download" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.bprvt.bprdownloader.ui.CursorOverlay
            android:id="@+id/cursorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
